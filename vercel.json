{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/video.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/video",
      "dest": "/api/video.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/youtube",
      "destination": "https://www.youtube.com/"
    },
    {
      "source": "/youtube/:path*",
      "destination": "https://www.youtube.com/:path*"
    },
    {
      "source": "/results",
      "destination": "https://www.youtube.com/results"
    },
    {
      "source": "/results/:path*",
      "destination": "https://www.youtube.com/results/:path*"
    },
    {
      "source": "/shorts",
      "destination": "https://www.youtube.com/shorts"
    },
    {
      "source": "/shorts/:path*",
      "destination": "https://www.youtube.com/shorts/:path*"
    },
    {
      "source": "/watch",
      "destination": "https://www.youtube.com/watch"
    },
    {
      "source": "/watch/:path*",
      "destination": "https://www.youtube.com/:path*"
    }
  ]
}