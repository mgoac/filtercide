{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/youtube",
      "destination": "https://www.youtubeunblocked.live/"
    },
    {
      "source": "/servers",
      "destination": "https://youtubeunblocked.live/servers"
    },
    {
      "source": "/go/:path*",
      "destination": "https://:path*"
    },
    {
      "source": "/www.youtubeunblocked.live/servers",
      "destination": "https://www.youtubeunblocked.live/servers"
    }
  ]
}